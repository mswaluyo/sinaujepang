<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>SinauJepang - Latihan Soal Bahasa Jepang & Tokutei Ginou</title>
  <!-- Tailwind CSS lokal (hasil build, siap produksi) -->
  <link rel="stylesheet" href="/assets/css/tailwind.css">
  <!-- Google Fonts & Font Awesome Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  
  <style>
    .bg-fuji-overlay {
      background: linear-gradient(135deg, rgba(240, 249, 255, 0.92) 0%, rgba(224, 242, 254, 0.88) 100%),
                  url('https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?q=80&w=1920&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }
  </style>
</head>
<body class="bg-fuji-50 text-slate-800 font-sans min-h-screen flex flex-col justify-between selection:bg-fuji-200">

  <!-- Header bersama: site-layout.js -->
<script src="/assets/js/indexeddb.js"></script>
<script src="/assets/js/site-layout.js"></script>
<main class="max-w-6xl mx-auto px-4 py-6 flex-grow w-full">
    <!-- Hero Section -->
    <section class="relative bg-fuji-overlay py-16 md:py-24 border-b border-fuji-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-fuji-100/90 text-fuji-700 text-xs sm:text-sm font-semibold border border-fuji-200 mb-6 backdrop-blur-sm">
          <i class="fa-solid fa-heart text-rose-500"></i>
          <span>100% Gratis Tanpa Biaya • Untuk Pejuang Tokutei Ginou</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-800 leading-tight mb-6">
          Tidak Ada Kata Terlambat.<br/>
          <span class="text-fuji-600">Raih Impian Tokutei Ginou ke Jepang!</span>
        </h1>

        <!-- Cerita Personal -->
        <div class="bg-white/85 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-fuji-200/80 shadow-md text-left max-w-2xl mx-auto mb-8 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-2 h-full bg-fuji-500"></div>
          <div class="flex items-start gap-4">
            <div class="p-3 bg-fuji-100 rounded-xl text-fuji-600 shrink-0 hidden sm:block">
              <i class="fa-solid fa-user-ninja text-2xl"></i>
            </div>
            <div>
              <h3 class="font-bold text-slate-800 text-lg mb-1 flex items-center gap-2">
                <span>Catatan Pejuang TG</span>
                <span class="text-xs font-normal text-fuji-700 bg-fuji-100 px-2 py-0.5 rounded-full">Kisah Nyata</span>
              </h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-3">
                "Saya paham rasanya belajar di usia yang tidak muda lagi. Ingatan tak lagi secepat dulu, menghafal kosakata terasa berat, dan Kanji sering kali lupa. Namun, impian untuk berangkat ke Jepang demi keluarga tidak boleh padam."
              </p>
              <p class="text-slate-700 text-sm font-medium">
                Website ini saya buat <span class="text-fuji-600 font-bold">sederhana dan gratis</span> agar kita bisa latihan pelan-pelan, mengulang tanpa batas, sampai benar-benar paham.
              </p>
            </div>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
          <button onclick="scrollToSoal()" class="flex-1 sm:w-auto bg-fuji-600 hover:bg-fuji-700 text-white font-bold px-5 py-3 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>Mulai Latihan Sekarang</span>
          </button>
          <a href="/kotoba.html" class="flex-1 sm:w-auto bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-semibold px-5 py-3 rounded-xl border border-emerald-200 shadow-sm transition-all flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-book-open text-emerald-600"></i>
            <span>Hafalan Kosakata</span>
          </a>
          <a href="/kanji.html" class="flex-1 sm:w-auto bg-rose-50 hover:bg-rose-100 text-rose-800 font-semibold px-5 py-3 rounded-xl border border-rose-200 shadow-sm transition-all flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-language text-rose-600"></i>
            <span>Daftar Kanji</span>
          </a>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-col sm:flex-row items-center justify-center gap-4">
          <button onclick="openDonationModal()" class="flex-1 sm:w-auto bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold px-5 py-3 rounded-xl border border-amber-200 shadow-sm transition-all flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-mug-hot text-amber-600"></i>
            <span>Traktir Kopi</span>
          </button>
        </div>
<section id="latihan-soal" class="py-14 bg-fuji-50"><div class="max-w-5xl mx-auto px-4 sm:px-6"><div class="text-center max-w-2xl mx-auto mb-10"><h2 class="text-2xl sm:text-3xl font-bold text-slate-800 mb-2">Pilih Paket Soal</h2><p class="text-slate-600 text-sm">17 paket &bull; 742 soal &bull; timer, audio, skor &amp; pembahasan instan.</p></div><div class="grid grid-cols-1 md:grid-cols-2 gap-5"><div id="paket-render-container"></div></div></section>

    <section class="py-14 bg-white border-t border-slate-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="bg-gradient-to-br from-amber-50/60 to-fuji-50/60 p-8 rounded-3xl border border-amber-200/60 text-center relative overflow-hidden shadow-sm">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
            <i class="fa-solid fa-mug-hot"></i>
          </div>
          <h2 class="text-2xl font-bold text-slate-800 mb-2">Merasakan Manfaat dari Website Ini?</h2>
          <p class="text-slate-600 text-sm max-w-2xl mx-auto mb-4 leading-relaxed">
            Website ini memanfaat fasilitas gratis agar bisa diakses siapapun tanpa biaya. Dukungan sukarela sekadar <strong>"Traktir Kopi"</strong> sangat berharga untuk mengapresiasi waktu &amp; tenaga dalam menyusun serta merapikan soal-soal di website ini.
          </p>
          <p class="text-slate-500 text-sm">Dukung dengan <span class="text-amber-600 font-semibold cursor-pointer hover:underline" onclick="openDonationModal()">Traktir Kopi</span> jika bermanfaat.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- Modal Login Google -->
  <div id="loginModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl relative border border-slate-100 text-center">
      <button onclick="closeLoginModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
      <div class="w-12 h-12 rounded-full bg-fuji-100 text-fuji-600 flex items-center justify-center mx-auto mb-4 text-xl">
        <i class="fa-solid fa-user-check"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Login Cepat &amp; Gratis</h3>
      <p class="text-slate-600 text-xs mb-6">Masuk dengan akun Google untuk menyimpan statistik dan riwayat nilai latihan Anda.</p>
      
      <button onclick="simulateLogin()" class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-50 text-slate-700 font-semibold py-3 px-4 rounded-xl border border-slate-300 shadow-sm transition-all mb-3 text-sm">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Lanjutkan dengan Google</span>
      </button>
      <p class="text-[11px] text-slate-400">100% Aman • Tidak ada biaya tersembunyi</p>
    </div>
  </div>

  <script type="module" src="/assets/js/firebase-init.js"></script>
  <script>
    // Inisialisasi SiteLayout agar header & footer tampil seketika
    if (typeof window.SiteLayout !== 'undefined') {
      window.SiteLayout.mountHeader();
      window.SiteLayout.mountFooter();
      window.SiteLayout.renderUser();
    }
  </script>
  <script src="/assets/js/score-cards.js"></script>
  <script src="/assets/js/pack-section-scores.js"></script>
  <script src="/assets/js/package-config.js"></script>
  <script src="/assets/js/package-render.js"></script>
  <script>
    // Fungsi utama untuk kontrol login & logout (IndexedDB-based)
    async function renderUser() {
      try {
        var u = null;
        try { u = await window.IndexedDB.getItem("jft_user"); } catch (e) {}
        var b = document.getElementById("loginBtn"), info = document.getElementById("uInfo");
        if (!u) { if (b) { b.innerHTML = '<span>Masuk Google</span>'; b.onclick = function(){ openLoginModal(); }; } if (info) { info.classList.add("hidden"); } return; }
        if (b) { b.innerHTML = '<i class="fa-solid fa-right-from-bracket"></i><span>Keluar</span>'; b.onclick = function(){ window.fujiLogout(); }; }
        if (info) { info.textContent = "Hi, " + (u.name || u.email); info.classList.remove("hidden"); }
      } catch (e) {}
    }
    function openLoginModal() { document.getElementById('loginModal').classList.remove('hidden'); }
    function closeLoginModal() { document.getElementById('loginModal').classList.add('hidden'); }
    async function simulateLogin() {
      try {
        var authMod = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js");
        var r = await authMod.signInWithPopup(window.fujiAuth, new authMod.GoogleAuthProvider());
        var u = r.user;
        try { window.IndexedDB.setItem("jft_user", { name: u.displayName, email: u.email, photo: u.photoURL }); } catch (e) {}
        closeLoginModal();
        renderUser();
      } catch (e) { alert("Gagal masuk: " + (e.message || e.code)); }
    }
    window.fujiLogout = async function () {
      // Redirect HANYA sekali, langsung, tanpa tunggu signOut
      try { window.IndexedDB.removeItem("jft_user"); } catch (e) {}
      window.fujiUser = null;
      try {
        var a = window.fujiAuth;
        if (a) { a.signOut().catch(function(){}); }
      } catch (e) {}
      location.replace("/login.html");
    };
    // Redirect ke login juga saat auth state berubah jadi null (misal token expired)
    // Tampilkan tombol Admin hanya utk admin (email allowlist, custom claim, ATAU dokumen /admins/{uid})
    var ADMIN_EMAILS = ["mswaluyo@gmail.com"];
    async function renderAdminBtn() {
      var el = document.getElementById("adminBtn");
      if (!el) return;
      function show(why) { try { console.log("[adminBtn v3] tampil via " + why); } catch (e) {}
        el.style.setProperty("display", "flex", "important"); }
      function hide(why) { try { console.log("[adminBtn v3] sembunyi: " + (why || "")); } catch (e) {}
        el.style.setProperty("display", "none", "important"); }
      try {
        var u = window.fujiUser;
        if (!window.fujiAuth || !window.fujiAuth.currentUser) {
          try { await new Promise(function (res) { var t0 = Date.now();
            (function poll() { if ((window.fujiAuth && window.fujiAuth.currentUser) || Date.now() - t0 > 8000) res(); else setTimeout(poll, 200); })(); }); } catch (e) {}
        }
        u = (window.fujiAuth && window.fujiAuth.currentUser) || window.fujiUser;
        if (!u) { hide("belum login"); return; }
        try {
          var em = (u.email || "").toLowerCase();
          if (ADMIN_EMAILS.indexOf(em) > -1) { show("email-allowlist"); return; }
        } catch (e) {}
        try {
          var tok = await u.getIdTokenResult(false);
          if (tok.claims && tok.claims.admin === true) { show("custom-claim"); return; }
        } catch (e) { try { console.log("[adminBtn] claim err " + (e.code || e.message)); } catch (x) {} }
        try {
          var fs = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js");
          var d = await fs.getDoc(fs.doc(window.fujiDb, "admins", u.uid));
          if (d.exists()) { show("dok-admins"); return; }
          else { try { console.log("[adminBtn] dok /admins/" + u.uid + " TIDAK ADA"); } catch (x) {} }
        } catch (e) { try { console.log("[adminBtn] dok err " + (e.code || e.message)); } catch (x) {} }
        hide("bukan admin");
      } catch (e) { hide("exception"); }
    }
    window.addEventListener("fuji:auth", function () {
      try {
        renderUser().catch(function(){});
        renderAdminBtn().catch(function(){});
      } catch (e) {}
    });
    renderUser().catch(function(){});
    setTimeout(function(){ renderAdminBtn().catch(function(){}); }, 1500);
    function scrollToSoal() {
      var t = document.getElementById('latihan-soal');
      if (t) t.scrollIntoView({ behavior: 'smooth' });
    }
    function openDonationModal() { document.getElementById('donationModal').classList.remove('hidden'); }
    function closeDonationModal() { document.getElementById('donationModal').classList.add('hidden'); }
    // Buka otomatis bila diarahkan dari halaman lain (SiteLayout.donate -> /?donasi=1)
    if (/(^|[?&])donasi=1/.test(location.search)) {
      setTimeout(function () { try { openDonationModal(); } catch (e) {} }, 400);
    }
  </script>
  <!-- Modal Traktir Kopi -->
  <div id="donationModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl relative border border-slate-100 text-center">
      <button onclick="closeDonationModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
      <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center mx-auto mb-4 text-xl">
        <i class="fa-solid fa-mug-hot"></i>
      </div>
      <h3 class="text-lg font-bold text-slate-800 mb-1">Traktir Kopi Pembuat Soal</h3>
      <p class="text-slate-600 text-xs mb-4">Scan QRIS berikut dari e-wallet / m-banking Anda. Terima kasih! ??</p>
      <img src="/assets/qris-sinaujepang.jpeg" alt="QRIS SinauJepang" class="w-56 mx-auto rounded-xl border border-slate-200 shadow-sm">
    </div>
  </div>
</body>
</html>

