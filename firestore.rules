// firestore.rules — SinauJepang v3 (dengan role admin)
// - User login: hanya bisa create + baca data MILIKNYA (email == auth email)
// - Admin: bisa baca/hapus SEMUA attempts, CRUD quiz_packs, kelola admins
// - Admin ditandai via Custom Claim (auth.token.admin == true)
//   ATAU dokumen /admins/{uid} { email, role: "admin" }
// - Set admin pertama via: npm run make-admin -- <emailUser>

rules_version = '2';
service cloud.firestore {
  // Top‑level deny as safety net
  match /{document=**} {
    allow read, write: if false;
  }

  match /databases/{databaseId}/documents {
    // Helper functions -----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(databaseId)/documents/admins/$(request.auth.uid))
      );
    }
    function ownerEmail(data) {
      return isSignedIn() &&
        data.email is string &&
        request.auth.token.email is string &&
        data.email == request.auth.token.email;
    }
    // Validators -----------------------------------------------------------
    function validateAttempt(data) {
      return data.email is string &&
        data.skor is int && data.skor >= 0 && data.skor <= 100 &&
        data.total is int && data.total >= 0 && data.total <= 100;
    }
    function validateProgress(data) {
      return data.uid is string &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 100 &&
        data.slug is string && data.slug.size() <= 64 &&
        data.picked is map && data.picked.size() <= 100 &&
        data.locked is map && data.locked.size() <= 100 &&
        data.cur is int && data.cur >= 0 && data.cur <= 1000 &&
        data.timerSec is int && data.timerSec >= 0 && data.timerSec <= 86400 &&
        data.updatedAt is timestamp &&
        data.keys().hasOnly(['uid', 'email', 'slug', 'picked', 'locked', 'cur', 'timerSec', 'updatedAt']);
    }
    function validateUser(data) {
      return data.name is string && data.name.size() <= 50 &&
        data.email is string && data.email == request.auth.token.email &&
        data.photo is string && data.photo.matches('^https?://');
    }
    // -------------------------------------------------------------------
    // --- Nilai siswa (1 dokumen per siswa-paket: {uid}_{slug}) ---
    match /attempts/{docId} {
      // Create: must be signed in, owner email matches, and fields are valid
      allow create: if isSignedIn() &&
                     ownerEmail(request.resource.data) &&
                     validateAttempt(request.resource.data);
      // Read: owner or admin
      allow get: if isSignedIn() &&
                  (resource.data.email == request.auth.token.email || isAdmin());
      // List: admin can list all, users can list only their own (handled client‑side)
      allow list: if isAdmin() || isSignedIn();
      // Update: owner can update but only allowed fields, admin unrestricted
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.email == request.auth.token.email &&
        request.resource.data.email == resource.data.email &&
        validateAttempt(request.resource.data) &&
        request.resource.data.keys().hasOnly(['skor','total','email'])
      );
      // Delete: admin only
      allow delete: if isAdmin();
    }

    // --- Progres sesi kuis lintas device (resume per akun) ---
    match /progress/{docId} {
      allow create: if isSignedIn() &&
                     request.resource.data.uid == request.auth.uid &&
                     validateProgress(request.resource.data);
      allow get, list: if isSignedIn() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if (isAdmin() || (
                       isSignedIn() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == resource.data.uid
                     )) && validateProgress(request.resource.data);
      allow delete: if isAdmin() || (
                       isSignedIn() &&
                       resource.data.uid == request.auth.uid
                     );
    }

    // --- Daftar admin ---
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Create / update / delete restricted to admins only
      allow create, update, delete: if isAdmin();
    }

    // --- Profil pengguna ---
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                     (request.auth.uid == uid || isAdmin()) &&
                     validateUser(request.resource.data);
      // Owner can update only whitelisted fields; admin unrestricted
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.email == resource.data.email &&
        validateUser(request.resource.data) &&
        request.resource.data.keys().hasOnly(['name','email','photo','updatedAt'])
      );
    }

    // --- Konten soal (public read, admin write) ---
    match /quiz_packs/{packId} {
      // Public read – documented intent; change to isSignedIn() if you want restriction
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Konfigurasi admin (GitHub token/repo) ---
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
