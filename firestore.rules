// firestore.rules — SinauJepang v3 (dengan role admin)
// - User login: hanya bisa create + baca data MILIKNYA (email == auth email)
// - Admin: bisa baca/hapus SEMUA attempts, CRUD quiz_packs, kelola admins
// - Admin ditandai via Custom Claim (auth.token.admin == true)
//   ATAU dokumen /admins/{uid} { email, role: "admin" }
// - Set admin pertama via: npm run make-admin -- <emailUser>
rules_version = '2';
service cloud.firestore {
  match /databases/{databaseId}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(databaseId)/documents/admins/$(request.auth.uid))
      );
    }
    function ownerEmail(data) {
      return isSignedIn()
        && data.email is string
        && request.auth.token.email is string
        && data.email == request.auth.token.email;
    }

    // --- Nilai siswa (1 dokumen per siswa-paket: {uid}_{slug}, upsert via setDoc merge) ---
    match /attempts/{docId} {
      // Buat nilai: wajib login + email dokumen = email login + field minimal valid
      allow create: if isSignedIn()
                    && ownerEmail(request.resource.data)
                    && request.resource.data.skor is number
                    && request.resource.data.total is number;
      // Baca 1 dokumen: pemilik atau admin
      allow get: if isSignedIn()
                  && (resource.data.email == request.auth.token.email || isAdmin());
      // List/query: admin bebas; user biasa tetap boleh query (wajib where email==miliknya di klien)
      allow list: if isAdmin() || isSignedIn();
      // Update: pemilik boleh menimpa dokumennya sendiri (upsert skor terbaru),
      // dengan syarat email tidak diganti. Hapus: admin saja.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.email == request.auth.token.email
                        && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    // --- Progres sesi kuis lintas device (resume per akun, kedaluwarsa 24 jam) ---
    // Dokumen: /progress/{uid}_{slug} = { uid, email, slug, picked, locked, cur, timerSec, updatedAt }
    // 1 dokumen per siswa per paket (update, bukan tambah) + dihapus saat kuis selesai.
    match /progress/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.slug is string;
      allow get, list: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // --- Daftar admin ---
    // Dokumen: /admins/{uid} = { email: string, role: "admin", createdAt: timestamp }
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Tulis admin baru: hanya admin (admin pertama via custom claim dari script make-admin)
      allow create, update, delete: if isAdmin();
    }

    // --- Profil pengguna (ditulis otomatis saat login) ---
    // Dokumen: /users/{uid} = { name, email, photo, createdAt, lastLoginAt, loginCount }
    // User boleh create/update MILIKNYA (uid == auth.uid, email cocok); baca miliknya; admin bisa list semua.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && (request.auth.uid == uid || isAdmin())
                    && (request.resource.data.email == request.auth.token.email || isAdmin());
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.email == resource.data.email);
    }

    // --- Konten soal (kelola via halaman admin, dibaca publik) ---
    // Dokumen: /quiz_packs/{slug} = { slug, title, items: [...], updatedAt, updatedBy }
    match /quiz_packs/{packId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // --- Konfigurasi admin (GitHub token/repo) ---
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
  }

}

